<Window x:Class="TrafficBoard.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="流量看板">
  <Grid x:Name="Root">
    <Grid.Resources>
      <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="FontSize" Value="12"/></Style>
      <Style x:Key="CardBorder" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="24"/></Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Background="Transparent" Padding="20,0,150,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE753;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="流量看板" FontSize="13"/><TextBlock Text="Windows" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="188" IsBackButtonVisible="Collapsed" SelectionChanged="Navigation_SelectionChanged" IsSettingsVisible="True">
      <NavigationView.MenuItems><NavigationViewItem x:Name="HomeItem" Content="我的订阅" Tag="home"><NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.MenuItems>
      <Grid Padding="28,12,28,20" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <InfoBar IsOpen="{Binding NoticeOpen, Mode=TwoWay}" Message="{Binding Notice}" Severity="Warning"/>
        <Grid Grid.Row="1">
          <Grid x:Name="HomePanel" RowSpacing="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Spacing="4"><TextBlock Text="我的订阅" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="{Binding Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              <Button Grid.Column="1" Click="RefreshAll_Click" VerticalAlignment="Center" ToolTipService.ToolTip="刷新所有订阅"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Refresh"/><TextBlock Text="全部刷新"/></StackPanel></Button>
              <Button Grid.Column="2" Click="Add_Click" VerticalAlignment="Center" Style="{ThemeResource AccentButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Add"/><TextBlock Text="添加订阅"/></StackPanel></Button>
            </Grid>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,12" SizeChanged="Cards_SizeChanged">
              <StackPanel Spacing="24">
                <Border CornerRadius="16" Padding="28"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#203A61"/><GradientStop Color="#315D85" Offset="1"/></LinearGradientBrush></Border.Background>
                  <StackPanel Spacing="10"><TextBlock Text="剩余流量，一眼看清" FontSize="28" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/><TextBlock Text="每 6 小时自动更新 · 支持手动刷新" Foreground="#DDE9F7"/><TextBlock Text="仅在应用运行时刷新；关闭窗口即退出，下次打开补充更新。" Foreground="#DDE9F7" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <StackPanel x:Name="EmptyPanel" Spacing="12" Padding="36" HorizontalAlignment="Center"><FontIcon Glyph="&#xE753;" FontSize="44" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="添加你的第一个订阅" FontSize="20" HorizontalAlignment="Center"/><TextBlock Text="粘贴服务商提供的 HTTPS 订阅链接，即可查看套餐额度。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="添加订阅" Click="Add_Click" HorizontalAlignment="Center"/></StackPanel>
                <ItemsRepeater x:Name="Cards" ItemsSource="{Binding Cards}">
                  <ItemsRepeater.Layout><UniformGridLayout x:Name="CardLayout" Orientation="Horizontal" MaximumRowsOrColumns="2" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill"/></ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate><DataTemplate>
                    <Border Style="{StaticResource CardBorder}"><StackPanel Spacing="18">
                      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Host}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Tag="{Binding Id}" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" VerticalAlignment="Top" ToolTipService.ToolTip="刷新此订阅" AutomationProperties.Name="刷新此订阅"><SymbolIcon Symbol="Refresh"/></Button></Grid>
                      <StackPanel Spacing="5"><TextBlock Text="已用 / 总额度" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding UsedTotal}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Spacing="10"><Grid><TextBlock Text="{Binding Remaining}"/><TextBlock Text="{Binding Percent}" HorizontalAlignment="Right"/></Grid><ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding Indeterminate}"/></StackPanel>
                      <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="到期时间" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding Expiry}" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="最近成功获取" Style="{StaticResource SectionLabel}"/><TextBlock Text="{Binding Updated}" TextWrapping="Wrap"/></StackPanel></Grid>
                      <TextBlock Text="{Binding Warning}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                      <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Grid.Column="1" Tag="{Binding Id}" Click="Detail_Click" Content="查看详情"/></Grid>
                    </StackPanel></Border>
                  </DataTemplate></ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock Text="统计来自服务商，可能存在延迟；未提供的信息显示为未知。链接仅加密保存在本机。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="DetailContent" Spacing="20" MaxWidth="900" HorizontalAlignment="Stretch"/></ScrollViewer>
          <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="22" MaxWidth="800" HorizontalAlignment="Stretch" Padding="0,0,16,24">
            <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}"/>
            <Border Style="{StaticResource CardBorder}"><StackPanel Spacing="14"><TextBlock Text="外观" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="选择主题，强调色跟随 Windows 设置。" TextWrapping="Wrap"/><ComboBox x:Name="ThemeChoice" Header="应用主题" SelectionChanged="ThemeChoice_SelectionChanged" MinWidth="220"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox></StackPanel></Border>
            <Border Style="{StaticResource CardBorder}"><StackPanel Spacing="16"><TextBlock Text="流量与到期提醒" FontSize="20" FontWeight="SemiBold"/><ToggleSwitch x:Name="UsageEnabled" Header="额度不足时提醒" OnContent="开启" OffContent="关闭"/><TextBox x:Name="UsageThresholds" Header="已使用百分比（%）" PlaceholderText="80, 95" Description="1–100，以逗号分隔，最多 8 个阈值"/><ToggleSwitch x:Name="ExpiryEnabled" Header="临近到期时提醒" OnContent="开启" OffContent="关闭"/><TextBox x:Name="ExpiryThresholds" Header="到期前天数" PlaceholderText="7, 3" Description="0–365，以逗号分隔；已到期也会提醒"/><TextBlock x:Name="NotificationStatus" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="打开 Windows 通知设置" Click="OpenNotifications_Click"/><Button Content="保存提醒设置" Click="SaveSettings_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Left"/></StackPanel></Border>
            <Border Style="{StaticResource CardBorder}"><StackPanel Spacing="12"><TextBlock Text="刷新与隐私" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="应用运行期间每 6 小时自动刷新，启动与系统恢复后补充更新过期数据。关闭窗口即完全退出，不注册托盘、开机启动或计划任务。" TextWrapping="Wrap"/><TextBlock Text="订阅与设置通过 Windows 当前用户 DPAPI 加密保存在本机；没有账户系统，不运行代理内核。卸载默认保留数据，卸载时可以选择删除。" TextWrapping="Wrap"/><TextBlock Text="流量看板 Windows 1.0.0 · MIT 开源" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><HyperlinkButton Content="GitHub 开源项目" NavigateUri="https://github.com/Max1426/traffic-board" Padding="0"/></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </Grid>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
